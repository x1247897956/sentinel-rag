# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，绝不提交
# PostgreSQL（pgvector）
DATABASE_URL=postgresql://sentinel:sentinel@localhost:55432/sentinel

# 生成 / 判分模型（OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 实测：请求 deepseek-chat 时返回的 model 字段是 deepseek-flash（见 docs/eval-report.md §1）
GEN_MODEL=deepseek-chat
# 判分模型与生成模型不同源（生成走 flash，判分走 pro）
JUDGE_MODEL=deepseek-v4-pro
JUDGE_BASE_URL=

# 检索与生成
# embedding：多语种 bge-m3（中文问题 + 英文安全语料，1024 维）
EMBED_MODEL=BAAI/bge-m3
# 重排后端：score_fusion（默认，确定性）| cross_encoder | llm
RERANK_BACKEND=score_fusion
RERANK_MODEL=BAAI/bge-reranker-base
CHUNK_TARGET=420
CHUNK_OVERLAP=80
RECALL_TOPK=30
FINAL_TOPN=6
CONTEXT_TOKEN_BUDGET=2600

# 拒答阈值：用两个绝对可比量（候选池内最大 ts_rank / 最大余弦相似度），
# 不能用池内归一化后的相对分——池内归一时冠军恒为 1.0，阈值会永远失效
REFUSAL_MIN_FTS=0.008
REFUSAL_MIN_COSINE=0.62

# 语料抓取上限（控制抓取耗时）
CORPUS_CVE_LIMIT=320
CORPUS_GHSA_LIMIT=120
CORPUS_ATTACK_LIMIT=60
CORPUS_OWASP_LIMIT=40
